# Environnement (development ou production)
NODE_ENV=development

# Serveur (dev uniquement, ignoré en prod Vercel)
PORT=5171

# Base de données
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# URL du frontend (pour CORS)
CLIENT_URL=http://localhost:3000

# Resend (envoi d'e-mails)
RESEND_API_KEY=<votre_clé_api_resend>
CONTACT_EMAIL=<email_destinataire_des_demandes_de_contact>
# Destinataire des inscriptions à la liste d'attente (défaut : contact@legomnia.com)
WAITLIST_EMAIL=contact@legomnia.com
# Expéditeur des e-mails : adresse d'un domaine vérifié sur Resend (sinon seul le propriétaire du compte Resend reçoit les e-mails)
MAIL_FROM=LegOmnia <notifications@legomnia.com>
# SMTP (ex. Infomaniak) : prioritaire sur Resend s'il est renseigné
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=notifications@legomnia.com
SMTP_PASS=<mot_de_passe_de_la_boite>

# Clé d'accès aux routes d'écriture du blog
# Générer avec : openssl rand -hex 32
ADMIN_API_KEY=<clé_admin>
