# Environnement (development ou production)
NODE_ENV=development

# Serveur (dev uniquement, ignoré en prod Vercel)
PORT=5171

# Base de données
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# URL du frontend (pour CORS)
CLIENT_URL=http://localhost:3000

# Resend (envoi d'e-mails)
RESEND_API_KEY=<votre_clé_api_resend>
# Expéditeur (domaine legomnia.com à vérifier dans Resend)
MAIL_FROM=LegOmnia <contact@legomnia.com>
# Destinataires des notifications (contact + liste d'attente), séparés par des virgules
NOTIFICATION_EMAILS=contact@legomnia.com,jp.bertaud@legomnia.com,alexandra.esmel@legomnia.com

# Clé d'accès aux routes d'écriture du blog
# Générer avec : openssl rand -hex 32
ADMIN_API_KEY=<clé_admin>
