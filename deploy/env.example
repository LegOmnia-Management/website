# À copier sur le VPS en /opt/legomnia/.env (chmod 600)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
CLIENT_URL=https://www.legomnia.com
RESEND_API_KEY=<clé_api_resend>
# Expéditeur : adresse d'un domaine vérifié sur Resend (ex. LegOmnia <noreply@legomnia.com>)
RESEND_FROM=LegOmnia <noreply@legomnia.com>
# Destinataire des demandes de contact (défaut : contact@legomnia.com)
CONTACT_EMAIL=<email_destinataire>
WAITLIST_EMAIL=contact@legomnia.com

# Clé d'accès aux routes d'écriture du blog
# Générer avec : openssl rand -hex 32
ADMIN_API_KEY=<clé_admin>
